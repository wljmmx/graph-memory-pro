{
  "id": "graph-memory-pro",
  "name": "Graph Memory Pro",
  "version": "2.4.0",
  "description": "Neo4j 知识图谱记忆引擎：三元组提取 + GDS 图算法 + 向量索引 + 双路径召回。无槽位插件，通过 registerMemoryCorpusSupplement 暴露给 memory-core，工具 + 后台服务模式运行。",
  "author": "Ananas <Wywelljob@gmail.com>",
  "license": "MIT",
  "contracts": {
    "tools": [
      "gm_record",
      "gm_maintain",
      "gm_reembed",
      "gm_feedback",
      "gm_bootstrap",
      "gm_benchmark",
      "gm_tune"
    ]
  },
  "uiHints": {
    "neo4j": {
      "label": "Neo4j 数据库连接",
      "help": "配置 Neo4j 图数据库连接参数"
    },
    "neo4j.password": {
      "label": "Neo4j 密码",
      "sensitive": true
    },
    "llm.apiKey": {
      "label": "LLM API Key",
      "sensitive": true
    },
    "embedding.apiKey": {
      "label": "Embedding API Key",
      "sensitive": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "neo4j": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "default": "bolt://localhost:37687"
          },
          "user": {
            "type": "string",
            "default": "neo4j"
          },
          "password": {
            "type": "string",
            "default": ""
          },
          "maxConnectionPoolSize": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "description": "v2.3.5: Neo4j driver max connection pool size (affects connection-pool metrics)"
          },
          "connectionAcquisitionTimeout": {
            "type": "integer",
            "default": 10000,
            "minimum": 1000,
            "description": "v2.3.5: Connection acquisition timeout in ms"
          }
        },
        "required": [
          "uri",
          "user",
          "password"
        ]
      },
      "compactTurnCount": {
        "type": "integer",
        "default": 6,
        "minimum": 1
      },
      "recallMaxNodes": {
        "type": "integer",
        "default": 6,
        "minimum": 1
      },
      "recallMaxDepth": {
        "type": "integer",
        "default": 2,
        "minimum": 1
      },
      "freshTailCount": {
        "type": "integer",
        "default": 10,
        "minimum": 0
      },
      "dedupThreshold": {
        "type": "number",
        "default": 0.9,
        "minimum": 0,
        "maximum": 1
      },
      "pagerankDamping": {
        "type": "number",
        "default": 0.85,
        "minimum": 0,
        "maximum": 1
      },
      "pagerankIterations": {
        "type": "integer",
        "default": 20,
        "minimum": 1
      },
      "timing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "reportEveryN": {
            "type": "integer",
            "default": 50,
            "minimum": 1
          },
          "maxSamples": {
            "type": "integer",
            "default": 1000,
            "minimum": 1
          }
        }
      },
      "llm": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "baseURL": {
            "type": "string",
            "default": ""
          },
          "model": {
            "type": "string",
            "default": ""
          },
          "apiKey": {
            "type": "string",
            "default": ""
          },
          "keepAlive": {
            "oneOf": [
              { "type": "string", "default": "" },
              { "type": "number", "default": -1 }
            ],
            "default": "",
            "description": "Ollama keep_alive 参数（仅 Ollama 识别，OpenAI 会忽略）。-1 永久驻留，5m/1h 等字符串表示 ttl"
          },
          "maxConcurrency": {
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "description": "v2.3.2 阶段二: 最大并发请求数（默认 1 for Ollama 本地，可调高 for 云端 API）"
          }
        }
      },
      "embedding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "baseURL": {
            "type": "string",
            "default": ""
          },
          "model": {
            "type": "string",
            "default": ""
          },
          "keepAlive": {
            "oneOf": [
              { "type": "string", "default": "" },
              { "type": "number", "default": -1 }
            ],
            "default": ""
          },
          "dimensions": {
            "type": "integer",
            "default": 1024
          },
          "apiKey": {
            "type": "string",
            "default": ""
          },
          "cacheSize": {
            "type": "integer",
            "default": 256,
            "minimum": 0,
            "description": "v2.3.2 阶段二: embed LRU 缓存容量（默认 256，0 禁用缓存）"
          },
          "cacheTtlMs": {
            "type": "integer",
            "default": 600000,
            "minimum": 0,
            "description": "v2.3.2 阶段二: embed LRU 缓存 TTL ms（默认 10min，0 禁用缓存）"
          },
          "options": {
            "type": "object",
            "additionalProperties": true,
            "default": {},
            "description": "透传给 Ollama /api/embed 的额外 options（如 num_ctx）"
          }
        }
      },
      "background": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extractorIntervalMs": {
            "type": "integer",
            "default": 60000,
            "minimum": 1000
          },
          "maintenanceIntervalMs": {
            "type": "integer",
            "default": 21600000,
            "minimum": 60000
          }
        }
      },
      "temporal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "defaultSource": {
            "type": "string",
            "enum": ["experience", "knowledge", "imported"],
            "default": "experience"
          }
        }
      },
      "state": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "filterSupersededInRecall": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "staleness": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "threshold": {
            "type": "number",
            "default": 0.7,
            "minimum": 0,
            "maximum": 1
          },
          "mode": {
            "type": "string",
            "enum": ["heuristic", "llm"],
            "default": "heuristic"
          }
        }
      },
      "causalEdges": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "extract": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "graphHealth": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "alertOnAnomaly": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "queryCache": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "maxSize": {
            "type": "integer",
            "default": 100,
            "minimum": 1
          },
          "ttlMs": {
            "type": "integer",
            "default": 1800000,
            "minimum": 1000
          },
          "similarityThreshold": {
            "type": "number",
            "default": 0.95,
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "judge": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "asyncMode": {
            "type": "boolean",
            "default": true
          },
          "judgeWarmupFeedbacks": {
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "description": "v2.3.5 B1: Judge 冷启动阈值（50→20）。冷启动期强制 Tier 1 启发式，配合 agent_end 自动反馈可快速达标。"
          },
          "heuristicMatch": {
            "type": "string",
            "enum": ["id", "name", "both"],
            "default": "both"
          },
          "tier": {
            "type": "integer",
            "enum": [1, 2, 3],
            "default": 1,
            "description": "v2.2.1：1=启发式 / 2=LLM 裁判 / 3=自定义策略"
          },
          "llmJudgeMaxNodes": {
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 50
          },
          "llmJudgeTimeoutMs": {
            "type": "integer",
            "default": 8000,
            "minimum": 1000,
            "maximum": 60000
          },
          "customStrategy": {
            "type": "string",
            "default": "",
            "description": "Tier 3 自定义策略名称（需先通过 JudgeManager.registerStrategy 注册）"
          }
        }
      },
      "feedback": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "retentionDays": {
            "type": "integer",
            "default": 90,
            "minimum": 1
          }
        }
      },
      "autoFeedback": {
        "type": "object",
        "additionalProperties": false,
        "description": "v2.3.5 B1: agent_end 自动反馈采集，破除冷启动死循环。默认启用，无需手动 gm_feedback。",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "是否启用自动反馈采集"
          },
          "trackGetExpansion": {
            "type": "boolean",
            "default": true,
            "description": "是否记录 get() 展开作为强使用信号"
          },
          "maxRecallRecordsPerSession": {
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "description": "单 session 最大召回缓存条数"
          }
        }
      },
      "warmup": {
        "type": "object",
        "additionalProperties": false,
        "description": "v2.3.5: 全局冷启动配置。judgeWarmupFeedbacks 已迁移到 judge 段，此处仅保留 warmupFeedbacks（M 矩阵冷启动）。",
        "properties": {
          "warmupFeedbacks": {
            "type": "integer",
            "default": 40,
            "minimum": 1,
            "description": "v2.3.5 B1: M 矩阵冷启动阈值（100→40）。配合 agent_end 自动反馈可快速达标。"
          }
        }
      },
      "associationMatrix": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "learningRate": {
            "type": "number",
            "default": 0.01,
            "exclusiveMinimum": 0
          },
          "momentum": {
            "type": "number",
            "default": 0.9,
            "minimum": 0,
            "maximum": 1
          },
          "adamBeta1": {
            "type": "number",
            "default": 0.9,
            "minimum": 0,
            "maximum": 1
          },
          "adamBeta2": {
            "type": "number",
            "default": 0.999,
            "minimum": 0,
            "maximum": 1
          },
          "warmupFeedbacks": {
            "type": "integer",
            "default": 40,
            "minimum": 1,
            "description": "v2.3.5 B1: M 矩阵冷启动阈值（100→40）。"
          }
        }
      },
      "marginalUtility": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "neighborhoodSize": {
            "type": "integer",
            "default": 5,
            "minimum": 1
          },
          "minImprovement": {
            "type": "number",
            "default": 0.0
          }
        }
      },
      "evolvableEmbedding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "reembedOnContentChange": {
            "type": "boolean",
            "default": true
          },
          "archiveKeepCount": {
            "type": "integer",
            "default": 3,
            "minimum": 1
          }
        }
      },
      "importance": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "weights": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "recency": {
                "type": "number",
                "default": 0.3,
                "minimum": 0
              },
              "frequency": {
                "type": "number",
                "default": 0.3,
                "minimum": 0
              },
              "centrality": {
                "type": "number",
                "default": 0.2,
                "minimum": 0
              },
              "source": {
                "type": "number",
                "default": 0.2,
                "minimum": 0
              }
            }
          },
          "recencyDecayDays": {
            "type": "integer",
            "default": 30,
            "minimum": 1
          },
          "frequencySaturation": {
            "type": "integer",
            "default": 10,
            "minimum": 1
          }
        }
      },
      "hierarchicalCommunity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "depth": {
            "type": "integer",
            "enum": [1, 2, 3],
            "default": 3
          }
        }
      },
      "conflictResolution": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "temporalPriority": {
            "type": "boolean",
            "default": true
          },
          "sourcePriority": {
            "type": "boolean",
            "default": true
          },
          "confidencePriority": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "edgeWeights": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "strengthenFactor": {
            "type": "number",
            "default": 1.1,
            "minimum": 1
          },
          "decayFactor": {
            "type": "number",
            "default": 0.95,
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "minWeight": {
            "type": "number",
            "default": 0.1,
            "minimum": 0
          },
          "maxWeight": {
            "type": "number",
            "default": 5.0,
            "minimum": 1
          }
        }
      },
      "reverseMemory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "recallThreshold": {
            "type": "integer",
            "default": 10,
            "minimum": 1
          },
          "stalenessPenalty": {
            "type": "number",
            "default": 0.1,
            "minimum": 0,
            "maximum": 1
          },
          "importanceFloor": {
            "type": "number",
            "default": 0.2,
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "benchmark": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "dataDir": {
            "type": "string",
            "default": ""
          },
          "maxCases": {
            "type": "integer",
            "default": 0,
            "minimum": 0
          },
          "buildGraph": {
            "type": "boolean",
            "default": true
          },
          "caseTimeoutMs": {
            "type": "integer",
            "default": 30000,
            "minimum": 1000
          }
        }
      },
      "autoTuner": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "regressionThreshold": {
            "type": "number",
            "default": 0.02,
            "minimum": 0,
            "maximum": 1
          },
          "stagnationThreshold": {
            "type": "integer",
            "default": 5,
            "minimum": 1
          },
          "maxRounds": {
            "type": "integer",
            "default": 10,
            "minimum": 1
          },
          "benchmarkMaxCases": {
            "type": "integer",
            "default": 50,
            "minimum": 0
          },
          "llmDiagnosis": {
            "type": "boolean",
            "default": true
          },
          "warmupFeedbacks": {
            "type": "integer",
            "default": 40,
            "minimum": 1,
            "description": "v2.3.5 B1: autoTuner 冷启动阈值（100→40）。"
          }
        }
      },
      "mcp": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "port": {
            "type": "integer",
            "default": 7800,
            "minimum": 1,
            "maximum": 65535
          },
          "host": {
            "type": "string",
            "default": "127.0.0.1"
          },
          "path": {
            "type": "string",
            "default": "/mcp"
          },
          "authToken": {
            "type": "string",
            "default": ""
          },
          "enabledTools": {
            "type": "array",
            "items": { "type": "string", "default": "" },
            "default": []
          }
        }
      },
      "apiServer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "port": {
            "type": "integer",
            "default": 7850,
            "minimum": 1,
            "maximum": 65535
          },
          "host": {
            "type": "string",
            "default": "127.0.0.1"
          },
          "authToken": {
            "type": "string",
            "default": ""
          }
        }
      },
      "recall": {
        "type": "object",
        "additionalProperties": false,
        "description": "v2.4.0: 检索质量与输出增强（记忆切片长度 / 长文本分段嵌入 / 多阶段检索 / 时序权重 / 标准格式化输出）。",
        "properties": {
          "memorySliceChars": {
            "type": "integer",
            "default": 800,
            "minimum": 1,
            "description": "点2：嵌入文本的记忆切片长度（字符数，默认 800，旧版硬编码 500）。仅作用于嵌入文本构造，不改变节点 content 存储。"
          },
          "chunking": {
            "type": "object",
            "additionalProperties": false,
            "description": "点6：长文本分段嵌入。启用后嵌入文本超过 chunkSize 会按 chunkSize 切分（含重叠），每段分别 embed 并保存到 chunkEmbeddings，提升长文本局部匹配能力。",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "chunkSize": {
                "type": "integer",
                "default": 400,
                "minimum": 1,
                "description": "单段字符数（默认 400）"
              },
              "chunkOverlap": {
                "type": "integer",
                "default": 40,
                "minimum": 0,
                "description": "段间重叠字符数（默认 40）"
              }
            }
          },
          "multiStage": {
            "type": "boolean",
            "default": false,
            "description": "点5：多阶段检索。启用后先通过图关系（FTS 种子 → graphWalk 邻域）筛选候选节点，再在候选中做向量相似度排序，减少全局向量搜索带来的无关节点干扰。"
          },
          "temporalWeight": {
            "type": "number",
            "default": 0.3,
            "minimum": 0,
            "maximum": 1,
            "description": "点4：时序权重（0~1，默认 0.3）。重排召回结果时结合节点 validTo/updatedAt 新鲜度做时序衰减，与关联矩阵 M 的关联分共同加权，避免过期/冲突节点被错误排前。"
          },
          "outputFormat": {
            "type": "object",
            "additionalProperties": false,
            "description": "点3：标准格式化输出。为系统提示注入「简洁、贴近原文、减少自由篡改」的输出约束。",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "concise": {
                "type": "boolean",
                "default": true,
                "description": "是否要求简洁（默认 true）"
              },
              "faithful": {
                "type": "boolean",
                "default": true,
                "description": "是否要求贴近原文表述（默认 true）"
              }
            }
          }
        }
      }
    }
  }
}
